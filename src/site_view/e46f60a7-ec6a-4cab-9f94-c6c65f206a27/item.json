    "css": "\/* Base Mobile Rules (Single column stack) *\/\r\n.choral-performance-grid {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1.5rem;\r\n    width: 100%;\r\n    margin-bottom: 2rem;\r\n}\r\n\r\n\/* PDF Section *\/\r\n.pdf-wrapper {\r\n    width: 100%;\r\n    height: 600px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 8px;\r\n    overflow: hidden;\r\n    background: #f9f9f9;\r\n}\r\n\r\n\/* Choral Parts Section *\/\r\n.parts-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 0.75rem;\r\n}\r\n\r\n.part-link-box {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 0.75rem;\r\n    padding: 1rem;\r\n    background-color: #f0f4f8;\r\n    border: 1px solid #d0d7de;\r\n    border-radius: 6px;\r\n    color: #1f2328;\r\n    text-decoration: none;\r\n    font-weight: 600;\r\n    transition: background-color 0.2s ease, border-color 0.2s ease;\r\n}\r\n\r\n.part-link-box:hover {\r\n    background-color: #e2e8f0;\r\n    border-color: #0969da;\r\n    color: #0969da;\r\n}\r\n\r\n\/* Video Section *\/\r\n.video-responsive-wrapper {\r\n    position: relative;\r\n    padding-bottom: 56.25%; \/* 16:9 Aspect Ratio *\/\r\n    height: 0;\r\n    overflow: hidden;\r\n    border-radius: 8px;\r\n    background-color: #000;\r\n}\r\n\r\n.video-responsive-wrapper iframe {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n}\r\n\r\n\/* Desktop Layout (Landscape \/ Screens wider than 992px) *\/\r\n@media (min-width: 992px) {\r\n    .choral-performance-grid {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr; \/* Two equal columns *\/\r\n        grid-template-rows: auto auto;   \/* Row 1: PDF + Parts | Row 2: Video *\/\r\n        grid-template-areas: \r\n            \"pdf parts\"\r\n            \"pdf video\";\r\n        gap: 1.5rem;\r\n        align-items: stretch;\r\n    }\r\n\r\n    .pdf-section {\r\n        grid-area: pdf;\r\n    }\r\n\r\n    .parts-section {\r\n        grid-area: parts;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: space-between; \/* Equally spaces the 4 links *\/\r\n    }\r\n\r\n    .part-link-box {\r\n        flex: 1; \/* Makes each of the 4 links equal height *\/\r\n        display: flex;\r\n        align-items: center;\r\n    }\r\n\r\n    .video-section {\r\n        grid-area: video;\r\n    }\r\n\r\n    .pdf-wrapper {\r\n        height: 100%; \/* Spans full height of the left column *\/\r\n        min-height: 650px;\r\n    }\r\n}",
